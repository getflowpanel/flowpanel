{
  "name": "@flowpanel/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "boundaries": "node scripts/check-boundaries.mjs",
    "build": "next build --webpack",
    "changelog": "node scripts/aggregate-changelog.mjs",
    "check:prerendered": "node scripts/check-prerendered.mjs",
    "check:snippets": "tsc -p tsconfig.docs-snippets.json --noEmit",
    "dev": "next dev --turbo",
    "lint": "biome check .",
    "postinstall": "fumadocs-mdx",
    "prebuild": "node --import tsx ../../scripts/docs/generate-cli-reference.ts",
    "predev": "node --import tsx ../../scripts/docs/generate-cli-reference.ts",
    "pretest:unit": "node --import tsx ../../scripts/docs/generate-cli-reference.ts",
    "pretypecheck": "node --import tsx ../../scripts/docs/generate-cli-reference.ts",
    "start": "next start",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "^16.17.9",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.9",
    "geist": "^1.8.2",
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@flowpanel/kit": "workspace:*",
    "@shikijs/twoslash": "^4.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-orm": "^0.45.4",
    "fumadocs-twoslash": "^3.3.1",
    "fumadocs-typescript": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "catalog:",
    "vite": "^7.3.7",
    "vitest": "catalog:"
  }
}
