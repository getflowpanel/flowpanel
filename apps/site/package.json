{
  "name": "@flowpanel/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node --import tsx ../../scripts/docs/generate-cli-reference.ts",
    "dev": "next dev --turbo",
    "prebuild": "node --import tsx ../../scripts/docs/generate-cli-reference.ts",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "pretest:unit": "node --import tsx ../../scripts/docs/generate-cli-reference.ts",
    "test:unit": "vitest run",
    "pretypecheck": "node --import tsx ../../scripts/docs/generate-cli-reference.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "changelog": "node scripts/aggregate-changelog.mjs",
    "check:snippets": "tsc -p tsconfig.docs-snippets.json --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "^16.14.5",
    "fumadocs-mdx": "^15.3.0",
    "fumadocs-ui": "^16.14.5",
    "geist": "^1.7.2",
    "lucide-react": "^0.475.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@flowpanel/kit": "workspace:*",
    "@shikijs/twoslash": "^4.1.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-orm": "^0.45.2",
    "fumadocs-twoslash": "^3.2.0",
    "fumadocs-typescript": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "catalog:",
    "vite": "^7.0.0",
    "vitest": "catalog:"
  }
}
