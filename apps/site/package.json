{
  "name": "@flowpanel/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "boundaries": "node scripts/check-boundaries.mjs",
    "build": "next build --webpack",
    "changelog": "node scripts/aggregate-changelog.mjs",
    "check:prerendered": "node scripts/check-prerendered.mjs",
    "check:snippets": "node --import tsx ../../scripts/docs/check-snippet-types.ts",
    "dev": "next dev --turbo",
    "lint": "biome check .",
    "postinstall": "fumadocs-mdx",
    "prebuild": "node --import tsx ../../scripts/docs/generate-cli-reference.ts",
    "predev": "node --import tsx ../../scripts/docs/generate-cli-reference.ts",
    "pretest:unit": "node --import tsx ../../scripts/docs/generate-cli-reference.ts",
    "pretypecheck": "node --import tsx ../../scripts/docs/generate-cli-reference.ts",
    "start": "next start",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "^16.16.2",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-ui": "^16.16.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.52.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@flowpanel/eslint-plugin": "workspace:*",
    "@flowpanel/kit": "workspace:*",
    "@playwright/test": "catalog:",
    "@shikijs/twoslash": "^4.5.0",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-orm": "catalog:",
    "fumadocs-twoslash": "^3.3.1",
    "fumadocs-typescript": "^4.0.14",
    "tailwindcss": "catalog:",
    "ts-morph": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.3",
    "vitest": "catalog:"
  }
}
