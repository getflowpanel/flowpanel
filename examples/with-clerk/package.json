{
  "name": "with-clerk",
  "private": true,
  "version": "0.0.3",
  "description": "FlowPanel + Clerk auth integration — minimal showcase of withClerk({ requireRole: 'admin' })",
  "scripts": {
    "build": "next build --webpack",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "dev": "next dev",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d --wait",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.22",
    "@flowpanel/adapter-drizzle": "workspace:*",
    "@flowpanel/core": "workspace:*",
    "@flowpanel/kit": "workspace:*",
    "@flowpanel/react": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
