{
  "name": "with-clerk",
  "private": true,
  "version": "0.0.3",
  "description": "FlowPanel + Clerk auth integration — minimal showcase of withClerk({ requireRole: 'admin' })",
  "scripts": {
    "build": "next build --webpack",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "dev": "next dev",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d --wait",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.11",
    "@flowpanel/adapter-drizzle": "workspace:*",
    "@flowpanel/core": "workspace:*",
    "@flowpanel/kit": "workspace:*",
    "@flowpanel/react": "workspace:*",
    "drizzle-orm": "catalog:",
    "next": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
