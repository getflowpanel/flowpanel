# Local dev defaults match docker-compose.yml. For a hosted demo,
# fill these with your provider's values and DO NOT commit the .env.
DATABASE_URL=postgres://fp:fp@localhost:54329/ai_scraper

# Turn the admin into a public read-only demo. When "true":
# - row actions are disabled with a tooltip
# - create/update/delete are gated off on every resource
# - a banner is rendered above the host header
DEMO_MODE=false

# Set to "off" to skip the in-memory live ticker (instrumentation.ts). Serverless
# hosts freeze it between requests, so turn it off there rather than shipping a
# feed that stops updating.
DEMO_LIVE=on

# Optional. When set, the admin shows live queue health metrics and
# `pnpm flowpanel:board` exposes bull-board.
# REDIS_URL=redis://localhost:6379

# Required whenever REDIS_URL is set. The board server runs on its own port, so
# the admin's `requireRole` does not cover it — this token is its only guard,
# and bull-board can retry, remove and drain jobs. Generate with:
#   openssl rand -hex 16
# BOARD_TOKEN=

# Where the board listens (board-server.ts) and where the browser reaches it
# (the admin's iframe). BOARD_URL must be an address the *visitor* can open, so
# any deployment has to set it — the localhost default is dev-only.
# BOARD_PORT=3001
# BOARD_URL=http://localhost:3001
