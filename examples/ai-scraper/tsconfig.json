{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    ".next/types/**/*.ts",
    "app/**/*",
    "drizzle.config.ts",
    "instrumentation.ts",
    "next.config.ts",
    "scripts/**/*",
    "src/**/*",
    ".next/e2e/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
