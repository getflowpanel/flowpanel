{
  "name": "ai-scraper",
  "private": true,
  "version": "0.0.5",
  "description": "FlowPanel end-to-end demo — AI web-scraping SaaS ops admin on Drizzle + Postgres",
  "scripts": {
    "build": "next build --webpack",
    "db:ensure": "tsx scripts/ensure-database.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "demo:cleanup": "tsx scripts/cleanup-demo.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "dev": "next dev",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d --wait",
    "flowpanel:board": "tsx scripts/board-server.mts",
    "start": "next start",
    "test:integration": "DEMO_POSTGRES_INTEGRATION=1 vitest run src/demo/sandbox/__tests__/postgres.integration.test.ts --no-file-parallelism",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowpanel/kit": "workspace:*",
    "@flowpanel/react": "workspace:*",
    "bullmq": "^5.81.4",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
