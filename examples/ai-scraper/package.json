{
  "name": "ai-scraper",
  "private": true,
  "version": "0.0.6",
  "description": "FlowPanel end-to-end demo — AI web-scraping SaaS ops admin on Drizzle + Postgres",
  "scripts": {
    "build": "next build --webpack",
    "db:ensure": "tsx scripts/ensure-database.ts",
    "db:migrate": "flowpanel migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "demo:cleanup": "tsx scripts/cleanup-demo.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "dev": "next dev",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d --wait",
    "flowpanel:board": "tsx scripts/board-server.mts",
    "start": "next start",
    "test:integration": "DEMO_POSTGRES_INTEGRATION=1 vitest run src/demo/sandbox/__tests__/postgres.integration.test.ts --no-file-parallelism",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowpanel/kit": "workspace:*",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "next": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@flowpanel/cli": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
