{
  "name": "flowpanel-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "test:unit": "turbo run test:unit",
    "test:e2e": "pnpm --filter @flowpanel/e2e test:e2e",
    "test:types": "turbo run test:types",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm --filter @flowpanel/site changelog",
    "release": "turbo run build && changeset publish",
    "prepare": "lefthook install || true",
    "docs:generate": "node --import tsx scripts/docs/generate-cli-reference.ts",
    "precheck:docs": "pnpm docs:generate",
    "check:docs": "node --import tsx scripts/check-docs.ts && pnpm --filter @flowpanel/site check:snippets",
    "check:cli-package": "node scripts/check-cli-package.mjs",
    "sync:licenses": "node scripts/sync-licenses.mjs",
    "check:release": "node scripts/check-release-consistency.mjs",
    "check:changesets": "changeset status",
    "check:cycles": "madge --circular --extensions ts,tsx packages/*/src"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.11",
    "@changesets/cli": "^2.30.0",
    "@size-limit/preset-small-lib": "^12.0.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "3.2.4",
    "lefthook": "^1.8.0",
    "madge": "^8.0.0",
    "pixelmatch": "^7.1.0",
    "publint": "^0.3.5",
    "size-limit": "^12.0.1",
    "tsx": "^4.19.0",
    "turbo": "^2.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=3 <5.0.9": "5.0.9",
      "body-parser@<1.20.6": "1.20.6",
      "body-parser@>=2 <2.3.0": "2.3.0",
      "esbuild@>=0.27.3 <0.28.1": "0.28.2",
      "js-yaml@>=4 <5": "4.3.1",
      "nanoid@>=3 <4": "3.3.18",
      "postcss@<8.5.18": "8.5.26",
      "qs@>=6.11.1 <6.15.2": "6.15.2",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
