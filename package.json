{
  "name": "flowpanel-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check:changesets": "changeset status",
    "check:cli-package": "node scripts/check-cli-package.mjs",
    "check:cycles": "madge --circular --extensions ts,tsx packages/*/src",
    "check:docs": "node --import tsx scripts/check-docs.ts && pnpm --filter @flowpanel/site check:snippets",
    "check:kit-package": "node scripts/check-kit-package.mjs",
    "check:next-onboarding": "node scripts/check-next-onboarding.mjs",
    "check:release": "node scripts/check-release-consistency.mjs",
    "docs:generate": "node --import tsx scripts/docs/generate-cli-reference.ts && node --import tsx scripts/docs/generate-init-snippets.ts",
    "docs:llms": "node --import tsx scripts/generate-llms.ts",
    "format": "biome check --write .",
    "lint": "biome check .",
    "precheck:docs": "node --import tsx scripts/docs/generate-cli-reference.ts",
    "prepare": "lefthook install || true",
    "release": "turbo run build && changeset publish",
    "sync:licenses": "node scripts/sync-licenses.mjs",
    "test:e2e": "pnpm --filter @flowpanel/e2e test:e2e",
    "test:scripts": "vitest run scripts/__tests__",
    "test:types": "turbo run test:types",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version && pnpm --filter @flowpanel/site changelog"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^13.1.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "lefthook": "^2.1.17",
    "madge": "^8.0.0",
    "publint": "^0.3.25",
    "size-limit": "^13.1.1",
    "ts-morph": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
