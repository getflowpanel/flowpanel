{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "site-tests/**/*.ts",
    "playwright.config.ts",
    "playwright.demo-readonly.config.ts",
    "playwright.site.config.ts",
    "global-setup.ts",
    "start-server.ts",
    "e2e-db.ts"
  ]
}
