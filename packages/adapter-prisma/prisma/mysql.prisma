generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/test-client-mysql"
}

datasource db {
  provider = "mysql"
  url      = "mysql://flowpanel:flowpanel@127.0.0.1:3306/flowpanel"
}

model TestUser {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String?
  active    Boolean   @default(true)
  age       Int?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
}
