generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/test-client-postgres"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://flowpanel:flowpanel@127.0.0.1:5432/flowpanel"
}

model TestUser {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String?
  active    Boolean   @default(true)
  age       Int?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  orders    TestOrder[]
}

model TestOrder {
  id     Int      @id @default(autoincrement())
  userId Int      @map("user_id")
  user   TestUser @relation(fields: [userId], references: [id])
  total  Decimal  @db.Decimal(10, 2)
  status String   @default("pending")

  @@map("test_orders")
}
