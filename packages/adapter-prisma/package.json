{
  "name": "@flowpanel/adapter-prisma",
  "version": "0.1.0",
  "description": "Prisma ORM adapter for FlowPanel",
  "keywords": [
    "flowpanel",
    "admin",
    "adapter",
    "prisma",
    "orm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getflowpanel/flowpanel.git",
    "directory": "packages/adapter-prisma"
  },
  "homepage": "https://github.com/getflowpanel/flowpanel",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "lint:attw": "attw --pack . --profile esm-only",
    "lint:publish": "publint --strict",
    "pretest:unit": "prisma generate --schema=prisma/schema.prisma",
    "test:types": "tsd",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "tsd": {
    "directory": "types-test",
    "compilerOptions": {
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "paths": {
        "@flowpanel/adapter-prisma": [
          "./dist/index.d.ts"
        ]
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0 <7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@flowpanel/core": "workspace:*"
  },
  "devDependencies": {
    "@prisma/client": "^5.20.0",
    "@testcontainers/mysql": "^11.14.0",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/node": "catalog:",
    "prisma": "^5.20.0",
    "tsd": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.0.0"
  }
}
