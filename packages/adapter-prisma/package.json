{
  "name": "@flowpanel/adapter-prisma",
  "version": "0.3.0",
  "private": true,
  "description": "Prisma ORM adapter for FlowPanel",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "pretest:unit": "prisma generate --schema=prisma/schema.prisma",
    "test:types": "tsd",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "tsd": {
    "directory": "types-test",
    "compilerOptions": {
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "paths": {
        "@flowpanel/adapter-prisma": [
          "./dist/index.d.ts"
        ]
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0 <7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "dependencies": {
    "@flowpanel/core": "workspace:*"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@testcontainers/mysql": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "catalog:",
    "prisma": "^5.22.0",
    "prisma5-internals": "npm:@prisma/internals@5.22.0",
    "prisma6-internals": "npm:@prisma/internals@6.19.3",
    "tsd": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
