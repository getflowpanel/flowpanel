{
  "name": "@flowpanel/next",
  "version": "0.1.0",
  "description": "Next.js 15 integration for FlowPanel — App Router pages, route handlers, server actions, drawers, and SSE",
  "keywords": [
    "flowpanel",
    "admin",
    "nextjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/getflowpanel/flowpanel",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/getflowpanel/flowpanel",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "lint:publish": "publint --strict",
    "lint:attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@flowpanel/core": "workspace:*",
    "@flowpanel/react": "workspace:*",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.3.0"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "next": "^15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.0.0"
  }
}
