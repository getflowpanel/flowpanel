{
  "name": "@flowpanel/charts",
  "version": "0.1.0",
  "description": "Recharts-backed chart widgets for FlowPanel dashboards",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/getflowpanel/flowpanel",
    "directory": "packages/charts"
  },
  "homepage": "https://github.com/getflowpanel/flowpanel",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "lint:publish": "publint --strict",
    "lint:attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@flowpanel/core": "workspace:*",
    "@flowpanel/react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "recharts": "^2.15.0 || ^3.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "^19.0.0",
    "recharts": "^3.0.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
