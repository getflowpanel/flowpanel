{
  "name": "@flowpanel/core",
  "version": "0.1.0",
  "description": "Core logic for FlowPanel — types, defineAdmin, runtime helpers",
  "keywords": [
    "flowpanel",
    "admin",
    "nextjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getflowpanel/flowpanel.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/getflowpanel/flowpanel",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "labels": [
        "./dist/labels.d.ts"
      ],
      "auth": [
        "./dist/auth.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./labels": {
      "import": {
        "types": "./dist/labels.d.ts",
        "default": "./dist/labels.mjs"
      },
      "require": {
        "types": "./dist/labels.d.cts",
        "default": "./dist/labels.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.mjs"
      },
      "require": {
        "types": "./dist/auth.d.cts",
        "default": "./dist/auth.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:types": "tsd",
    "lint:publish": "publint --strict",
    "lint:attw": "attw --pack ."
  },
  "tsd": {
    "directory": "types-test",
    "compilerOptions": {
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "paths": {
        "@flowpanel/core": [
          "./dist/index.d.ts"
        ],
        "@flowpanel/core/labels": [
          "./dist/labels.d.ts"
        ]
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "ioredis": "^5.10.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "expect-type": "^0.20.0",
    "react": "^19.0.0",
    "tsd": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.0.0"
  }
}
