{
  "name": "@flowpanel/adapter-bullmq",
  "version": "0.1.0",
  "description": "BullMQ queue UIs for FlowPanel via bull-board",
  "keywords": [
    "flowpanel",
    "admin",
    "adapter",
    "bullmq",
    "bull-board",
    "queue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getflowpanel/flowpanel.git",
    "directory": "packages/adapter-bullmq"
  },
  "homepage": "https://github.com/getflowpanel/flowpanel",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./board": {
      "types": "./dist/board.d.ts",
      "import": "./dist/board.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "lint:publish": "publint --strict",
    "lint:attw": "attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@bull-board/api": "^6.0.0",
    "@bull-board/express": "^6.0.0",
    "bullmq": "^5.0.0",
    "express": "^4.19.0"
  },
  "peerDependenciesMeta": {
    "@bull-board/api": {
      "optional": true
    },
    "@bull-board/express": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bull-board/api": "^6.0.0",
    "@bull-board/express": "^6.0.0",
    "@types/express": "^4.17.0",
    "bullmq": "^5.0.0",
    "express": "^4.19.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
