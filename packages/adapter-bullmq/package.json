{
  "name": "@flowpanel/adapter-bullmq",
  "version": "0.3.0",
  "private": true,
  "description": "BullMQ queue UIs for FlowPanel via bull-board",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./board": {
      "types": "./dist/board.d.ts",
      "import": "./dist/board.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@bull-board/api": ">=6.0.0 <10.0.0",
    "@bull-board/express": ">=6.0.0 <10.0.0",
    "bullmq": "^5.0.0 || ^6.0.0",
    "express": "^4.19.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@bull-board/api": {
      "optional": true
    },
    "@bull-board/express": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "bullmq": "catalog:",
    "express": "^5.2.1",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
