{
  "name": "@flowpanel/cli",
  "version": "0.3.0",
  "description": "CLI for FlowPanel: init, dev, new, migrate, doctor and eject",
  "keywords": [
    "flowpanel",
    "cli",
    "admin",
    "admin-panel",
    "nextjs",
    "scaffolding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getflowpanel/flowpanel.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/getflowpanel/flowpanel",
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "flowpanel": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint:attw": "attw --pack .",
    "lint:publish": "publint --strict",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^14.0.3",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "ts-morph": "catalog:"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "^7.8.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
