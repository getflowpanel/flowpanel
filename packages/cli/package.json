{
  "name": "@flowpanel/cli",
  "version": "0.1.0",
  "description": "CLI for FlowPanel — init, migrate, doctor",
  "keywords": [
    "flowpanel",
    "cli",
    "admin",
    "nextjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/getflowpanel/flowpanel",
    "directory": "packages/cli"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "flowpanel": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "dev": "tsx src/index.ts",
    "lint:publish": "publint --strict",
    "lint:attw": "attw --pack ."
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "commander": "^12.0.0",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "catalog:",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss3": "npm:tailwindcss@^3.4.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
