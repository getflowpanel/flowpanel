{
  "name": "@flowpanel/cli",
  "version": "0.2.0",
  "description": "CLI for FlowPanel — init, dev, new, migrate, doctor and eject",
  "keywords": [
    "flowpanel",
    "cli",
    "admin",
    "admin-panel",
    "nextjs",
    "scaffolding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getflowpanel/flowpanel.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/getflowpanel/flowpanel",
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "flowpanel": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint:attw": "attw --pack .",
    "lint:publish": "publint --strict",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^12.0.0",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "catalog:",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tailwindcss3": "npm:tailwindcss@^3.4.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
