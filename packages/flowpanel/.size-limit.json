[
  {
    "name": "@flowpanel/kit/react (UI bundle)",
    "path": "dist/react.js",
    "import": "{ AdminShell, DataTable, AutoForm, Form }",
    "limit": "79 KB"
  },
  {
    "name": "@flowpanel/kit/client (hooks)",
    "path": "dist/client.js",
    "import": "{ useAdminMutation }",
    "limit": "25 KB"
  },
  {
    "name": "@flowpanel/kit/charts (own code; Recharts not counted)",
    "path": "dist/charts.js",
    "import": "{ AreaChart, BarChart, LineChart, PieChart }",
    "limit": "8 KB",
    "ignore": ["recharts"]
  }
]
