{
  "name": "@flowpanel/kit",
  "version": "0.1.0",
  "description": "Config-first admin panel framework for Next.js 16",
  "keywords": [
    "flowpanel",
    "admin",
    "admin-panel",
    "dashboard",
    "nextjs",
    "react",
    "crud",
    "rbac",
    "drizzle",
    "prisma"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getflowpanel/flowpanel.git",
    "directory": "packages/flowpanel"
  },
  "homepage": "https://github.com/getflowpanel/flowpanel",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./next/client": {
      "types": "./dist/next-client.d.ts",
      "import": "./dist/next-client.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq.d.ts",
      "import": "./dist/bullmq.js"
    },
    "./bullmq/board": {
      "types": "./dist/bullmq-board.d.ts",
      "import": "./dist/bullmq-board.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./charts/runtime": {
      "types": "./dist/charts-runtime.d.ts",
      "import": "./dist/charts-runtime.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "import": "./dist/prisma.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "lint:publish": "publint --strict",
    "lint:attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@flowpanel/adapter-bullmq": "workspace:*",
    "@flowpanel/adapter-drizzle": "workspace:*",
    "@flowpanel/adapter-prisma": "workspace:*",
    "@flowpanel/charts": "workspace:*",
    "@flowpanel/client": "workspace:*",
    "@flowpanel/core": "workspace:*",
    "@flowpanel/next": "workspace:*",
    "@flowpanel/react": "workspace:*"
  },
  "peerDependencies": {
    "@bull-board/api": "^6.0.0",
    "@bull-board/express": "^6.0.0",
    "@prisma/client": ">=5.0.0 <7.0.0",
    "bullmq": "^5.0.0",
    "express": "^4.19.0",
    "drizzle-orm": ">=0.45.2 <1.0.0",
    "ioredis": "^5.10.0",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0 || ^3.0.0",
    "tailwindcss": "^3.0.0 || ^4.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@bull-board/api": {
      "optional": true
    },
    "@bull-board/express": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
