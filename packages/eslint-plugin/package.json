{
  "name": "@flowpanel/eslint-plugin",
  "version": "0.2.0",
  "description": "ESLint rules for FlowPanel admin configs",
  "keywords": [
    "flowpanel",
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "admin",
    "lint"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getflowpanel/flowpanel.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://github.com/getflowpanel/flowpanel",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "lint:attw": "attw --pack .",
    "lint:publish": "publint --strict",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.68.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/rule-tester": "^8.68.0",
    "eslint": "^9.0.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
