{
  "name": "@flowpanel/adapter-drizzle",
  "version": "0.3.0",
  "private": true,
  "description": "Drizzle ORM adapter for FlowPanel",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test:types": "tsd",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "tsd": {
    "directory": "types-test",
    "compilerOptions": {
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "paths": {
        "@flowpanel/adapter-drizzle": [
          "./dist/index.d.ts"
        ],
        "@flowpanel/core": [
          "../core/dist/index.d.ts"
        ],
        "@flowpanel/core/auth": [
          "../core/dist/auth.d.ts"
        ]
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.2 <1.0.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@flowpanel/core": "workspace:*",
    "drizzle-zod": "^0.8.3"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "catalog:",
    "mysql2": "^3.24.5",
    "postgres": "^3.4.9",
    "tsd": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
