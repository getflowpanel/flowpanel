{
  "name": "@flowpanel/react",
  "version": "0.1.0",
  "description": "Internal UI primitives for FlowPanel — shadcn-style components built on Radix + Tailwind v4 + design tokens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/getflowpanel/flowpanel",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/getflowpanel/flowpanel",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styles/admin.css": "./src/styles/admin.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "lint:publish": "publint --strict",
    "lint:attw": "attw --pack . --profile esm-only --exclude-entrypoints ./styles/admin.css"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.0.0"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md"
  ],
  "dependencies": {
    "@conform-to/react": "^1.21.0",
    "@conform-to/zod": "^1.21.0",
    "@flowpanel/core": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "^15.11.7",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
