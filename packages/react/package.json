{
  "name": "@flowpanel/react",
  "version": "0.2.0",
  "description": "Admin UI components for FlowPanel — shell, data table, forms, widgets and realtime hooks built on Radix UI + Tailwind v4 + design tokens",
  "keywords": [
    "flowpanel",
    "admin",
    "admin-panel",
    "react",
    "ui-components",
    "radix-ui",
    "tailwindcss",
    "design-tokens"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getflowpanel/flowpanel.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/getflowpanel/flowpanel",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styles/admin.css": "./src/styles/admin.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "lint:attw": "attw --pack . --profile esm-only --exclude-entrypoints ./styles/admin.css",
    "lint:publish": "publint --strict",
    "test:types": "tsd",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "tsd": {
    "directory": "types-test",
    "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "paths": {
        "@flowpanel/react": [
          "./dist/index.d.ts"
        ]
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.0.0 || ^4.0.0",
    "zod": "^4.0.0"
  },
  "files": [
    "dist",
    "src/styles/admin.css",
    "README.md"
  ],
  "dependencies": {
    "@conform-to/react": "^1.21.1",
    "@conform-to/zod": "^1.21.1",
    "@flowpanel/core": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "^15.11.7",
    "jsdom": "^29.1.1",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsd": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
