{
  "name": "@flowpanel/react",
  "version": "0.3.0",
  "private": true,
  "description": "Admin UI components for FlowPanel: shell, data table, forms, widgets and realtime hooks",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styles/admin.css": "./src/styles/admin.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test:types": "tsd",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "tsd": {
    "directory": "types-test",
    "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "paths": {
        "@flowpanel/react": [
          "./dist/index.d.ts"
        ]
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "next": ">=15.5.0 <17.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@conform-to/react": "^1.21.1",
    "@conform-to/zod": "^1.21.1",
    "@flowpanel/core": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.52.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "^30.1.2",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsd": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
