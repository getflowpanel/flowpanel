{
  "name": "@flowpanel/test",
  "version": "0.3.0",
  "description": "Playwright smoke test for a FlowPanel admin, and a widget context for unit tests",
  "keywords": [
    "flowpanel",
    "admin",
    "playwright",
    "smoke-test",
    "accessibility",
    "testing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getflowpanel/flowpanel.git",
    "directory": "packages/test"
  },
  "homepage": "https://github.com/getflowpanel/flowpanel",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./widgets": {
      "import": {
        "types": "./dist/widgets.d.ts",
        "default": "./dist/widgets.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "lint:attw": "attw --pack . --exclude-entrypoints ./widgets && attw --pack . --entrypoints ./widgets --profile esm-only",
    "lint:publish": "publint --strict",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@flowpanel/kit": ">=0.4.0 <1.0.0",
    "@playwright/test": "^1.50.0"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": {
      "optional": true
    },
    "@flowpanel/kit": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@flowpanel/kit": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
