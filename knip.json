{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": ["examples/*", "packages/e2e"],
  "ignore": ["**/types-test/**"],
  "ignoreDependencies": [
    "@axe-core/playwright",
    "@vitest/coverage-v8",
    "lefthook",
    "pixelmatch",
    "vitest"
  ],
  "exclude": ["exports", "types"],
  "workspaces": {
    ".": {
      "entry": ["scripts/check-file-sizes.ts", "scripts/check-import-boundaries.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/react": {
      "entry": ["src/_atoms/Kbd.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/next": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/charts": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/client": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/adapter-drizzle": {
      "ignoreDependencies": ["testcontainers"]
    },
    "packages/adapter-bullmq": {
      "ignoreDependencies": ["@flowpanel/core"]
    },
    "packages/eslint-plugin": {
      "ignoreDependencies": ["@typescript-eslint/parser"]
    },
    "apps/site": {
      "entry": ["src/**/index.ts"],
      "ignoreDependencies": ["@shikijs/twoslash", "postcss"]
    }
  }
}
